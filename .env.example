# Generate with: openssl rand -hex 32. Keep this value outside git.
CREDENTIALS_ENCRYPTION_KEY=
REMOTE_MCP_URL=http://localhost:3000/sse
MCP_TRANSPORT=sse
# Optional overrides for container/Railway volume mounts.
MCP_CREDENTIALS_FILE=/data/credentials.enc
MCP_STORAGE_DIR=/data/mcp-inspector
MCP_INSPECTOR_SECRET_STORE=file
MCP_INSPECTOR_SECRET_FILE=/data/secrets.json